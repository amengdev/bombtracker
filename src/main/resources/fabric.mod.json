{
	"schemaVersion": 1,
	"id": "bombtracker",
	"version": "${version}",
	"name": "Bomb Tracker",
	"description": "Detects Wynncraft bomb announcements and reports them to a backend.",
	"authors": [
		"amengdev"
	],
	"contact": {
		"sources": "https://github.com/amengdev/bombtracker"
	},
	"license": "CC0-1.0",
	"icon": "assets/bombtracker/icon.png",
	"environment": "client",
	"entrypoints": {
		"main": [
			"io.github.amengdev.bombtracker.Bombtracker"
		],
		"client": [
			"io.github.amengdev.bombtracker.client.BombtrackerClient"
		]
	},
	"mixins": [
		"bombtracker.mixins.json",
		{
			"config": "bombtracker.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	}
}